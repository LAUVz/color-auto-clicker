#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "assets\\pointer.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION {{VERSION_COMMA}}
 PRODUCTVERSION {{VERSION_COMMA}}
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Veloxim"
            VALUE "FileDescription", "Color Auto Clicker - Automated clicking based on color detection"
            VALUE "FileVersion", "{{VERSION}}"
            VALUE "InternalName", "ColorAutoClicker"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "ColorAutoClicker.exe"
            VALUE "ProductName", "Color Auto Clicker"
            VALUE "ProductVersion", "{{VERSION}}"
            VALUE "Author", "Henrijs Kons"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
