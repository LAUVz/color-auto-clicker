{
  "name": "color-clicker",
  "version": "1.0.0",
  "description": "Cross-platform color detection and auto-clicker",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && start.bat",
    "dev": "tsc && start.bat",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64 --arm64"
  },
  "keywords": [
    "automation",
    "color-detection",
    "auto-clicker",
    "cross-platform"
  ],
  "author": "Henrijs Kons",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.1.0",
    "electron": "30.5.1",
    "electron-builder": "^26.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "robotjs": "^0.6.0"
  },
  "build": {
    "appId": "com.veloxim.colorclicker",
    "productName": "ColorClicker",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/index.html",
      "src/styles.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/pointer.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Utility",
      "icon": "assets/pointer.png"
    }
  }
}
